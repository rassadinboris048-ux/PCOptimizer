<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyTitle>PCOptimizer</AssemblyTitle>
    <Product>PCOptimizer</Product>
    <Version>1.0.0</Version>

    <!-- Иконка окна и файла, плюс манифест с настройками прав и DPI -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- WebView2 тянет WPF-сборку WindowsBase и это даёт безобидное
         предупреждение MSB3277. Понижаем его до сообщения, чтобы не мешало. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Интерфейс дашборда и иконка должны лежать рядом с exe -->
    <None Update="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
